ggplot(gss_cleaned, aes(x = sexorient, fill = factor(discrim))) +
geom_bar(position = "fill") +
labs(
title = "Distribution of Workplace Discrimination by Sexual Orientation",
x = "Sexual Orientation",
y = "Proportion",
fill = "Discrimination"
) +
scale_fill_manual(
values = c("0" = "gray70", "1" = "dodgerblue"),
labels = c("No", "Yes")
) +
theme_minimal()
model <- glm(discrim ~ sexorient + race + wrkstat,
data = gss_cleaned,
family = "binomial")
library(ggeffects)
install.packages("ggeffects")
library(ggeffects)
prediction <- ggpredict(model, terms = "sexorient")
ggplot(pred, aes(x = x, y = predicted)) +
geom_point(size = 3, color = "dodgerblue") +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.1) +
labs(
title = "Predicted Probability of Workplace Discrimination",
x = "Sexual Orientation",
y = "Predicted Probability"
) +
theme_minimal()
ggplot(prediction, aes(x = x, y = predicted)) +
geom_point(size = 3, color = "dodgerblue") +
geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.1) +
labs(title = "Predicted Probability of Workplace Discrimination",
x = "Sexual Orientation",
y = "Predicted Probability") +
theme_minimal()
#First Visual
ggplot(gss_cleaned, aes(x = sexorient, y = discrim)) +
stat_summary(fun = mean, geom = "bar", fill = "dodgerblue") +
labs(title = "Workplace Discrimination by Sexual Orientation",
x = "Sexual Orientation",
y = "Proportion Reporting Discrimination")
ggsave("output/Workplace_Discrimination_by Sexual_Orientation.png", width = 10, height = 6)
